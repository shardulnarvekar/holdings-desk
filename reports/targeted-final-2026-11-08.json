        "evidence": {
          "sql": "SELECT p.portfolio_name, COALESCE(SUM(CASE WHEN s.sector_id = (SELECT sector_id FROM sectors WHERE sector_name = :sector_name) THEN h.quantity * s.current_price ELSE 0 END), 0) AS tech_value, SUM(h.quantity * s.current_price) AS total_value, ROUND((COALESCE(SUM(CASE WHEN s.sector_id = (SELECT sector_id FROM sectors WHERE sector_name = :sector_name) THEN h.quantity * s.current_price ELSE 0 END), 0) * 100.0) / SUM(h.quantity * s.current_price), 2) AS tech_percentage FROM portfolios p JOIN holdings h ON p.portfolio_id = h.portfolio_id JOIN securities s ON h.security_id = s.security_id GROUP BY p.portfolio_id, p.portfolio_name HAVING SUM(CASE WHEN s.sector_id = (SELECT sector_id FROM sectors WHERE sector_name = :sector_name) THEN 1 ELSE 0 END) > 0 ORDER BY tech_percentage DESC;",
